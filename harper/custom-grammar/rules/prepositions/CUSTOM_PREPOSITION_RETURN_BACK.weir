expr main (return back)

let message "Drop back after return."
let description "Removes a narrow redundant preposition in a local phrase."
let kind "Grammar"
let status "disabled"
let becomes "return"
let strategy "Exact"

allows "Please return."
allows "She returned home."
allows "They will return now."
allows "Why return again?"
allows "He will return tomorrow."
allows "The return-back note was odd."
allows "We had to return, back in the day, to the office."
allows "Return the book back to the shelf."
allows "The return policy is clear."
allows "We should return before dark."
allows "Please return back."
allows "She returned back home."
allows "They return back now."
allows "Why return back again?"
allows "He will return back tomorrow."
