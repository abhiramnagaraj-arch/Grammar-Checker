expr main (discuss about)

let message "Drop about after discuss."
let description "Removes a fixed redundant preposition in a local phrase."
let kind "Grammar"
let status "disabled"
let becomes "discuss"
let strategy "Exact"

allows "We discuss the plan."
allows "We talk about the plan."
allows "She discussed it yesterday."
allows "They are discussing the report."
allows "Why discuss this now?"
allows "The discussion about the plan was long."
allows "He will discuss it later."
allows "The phrase discuss-and-respond is common in some drafts."
allows "We discussed, about the plan, the budget."
allows "Discussing about is not standard."
allows "We discuss about the plan."
allows "She discussed about it yesterday."
allows "They discuss about the report."
allows "Why discuss about this now?"
allows "He will discuss about the change."
