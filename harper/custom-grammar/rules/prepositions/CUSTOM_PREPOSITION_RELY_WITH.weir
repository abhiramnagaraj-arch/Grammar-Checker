expr main (rely with)

let message "Use rely on instead of rely with."
let description "Fixes a narrow fixed preposition combination."
let kind "Grammar"
let status "disabled"
let becomes "rely on"
let strategy "Exact"

allows "We rely on the data."
allows "We depend on the data."
allows "She relied on him."
allows "They are relying on the report."
allows "Why rely on this now?"
allows "The phrase rely-on is common."
allows "He will rely on our notes."
allows "We relied, with care, on the notes."
allows "Relying with caution was mentioned."
allows "The team may rely on confidence."
allows "We rely with the data."
allows "She relied with him."
allows "They rely with the report."
allows "Why rely with this now?"
allows "He will rely with our notes."
